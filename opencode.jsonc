{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "model": "openai/gpt-6.1-sol",
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna",
    },
  },
  "default_agent": "build",
  "compaction": {
    "auto": true,
  },
  "permissions": [
    // Git commands
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git branch *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" },
    { "action": "shell", "resource": "git pull *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    // Go commands
    { "action": "shell", "resource": "go build *", "effect": "allow" },
    { "action": "shell", "resource": "go fmt *", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "go vet *", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint *", "effect": "allow" },
    // File searching and manipulation
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
  ],
  "mcp": {
    "servers": {
      "codebase-memory-mcp": {
        "disabled": false,
        "type": "local",
        "command": ["/Users/fepozopo/.local/bin/codebase-memory-mcp"],
      },
    },
  },
}
