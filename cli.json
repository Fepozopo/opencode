{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "animations": true,
  "scroll": {
    "speed": 3,
    "acceleration": false
  },
  "cursor": {
    "style": "block",
    "blinking": true
  },
  "session": {
    "scrollbar": false,
    "thinking": "show",
    "verbosity": "high"
  },
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "view": "unified"
  },
  "highlights": true,
  "mini": {
    "thinking": "show",
    "tools": "show",
    "shell_output": "show",
    "turn_summary": "show",
    "footer": "show",
    "splash": "show",
    "work_spinner": "block-soft-slide",
    "mono": false,
    "replay": true,
    "replay_limit": 200
  }
}
